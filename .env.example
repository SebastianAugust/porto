# --- Contact form (Resend) ---
# Get a key at https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered (your inbox).
CONTACT_TO_EMAIL=sebastianagustinolie@gmail.com

# The "from" address. For quick testing use Resend's shared sender below — it
# works with no domain setup, but can ONLY deliver to the email on your Resend
# account. To send from your own domain, verify it in Resend and use e.g.
# "Sebastian August <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
